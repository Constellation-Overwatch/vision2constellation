# C4 threat ISR runtime
VISION_MODEL=yoloe_c4isr
VISION_CONFIDENCE=0.25
VISION_OUTPUT_ENCODER=h264_nvenc
VISION_OUTPUT_FPS=15
VISION_OUTPUT_BITRATE=4M
VISION_OUTPUT_RECONNECT_DELAY=3

# Fresh Constellation Overwatch deployment
CONSTELLATION_ORG_ID=default
CONSTELLATION_ENTITY_ID=REPLACE_WITH_PULSAR_ENTITY_ID
NATS_URL=nats://REPLACE_WITH_OVERWATCH_MAGICDNS:4223
NATS_SUBJECT_ROOT=constellation.events.isr
ENABLE_FRAME_STREAMING=false

# RTSP input resilience
RTSP_MAX_FAILURES=30
RTSP_RECONNECT_DELAY=1
